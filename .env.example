# ─────────────────────────────────────────────────────────────
# TripMate 환경변수
# `cp .env.example .env` 후 값을 채운다. .env 는 절대 커밋하지 않는다.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── 서버 ────────────────────────────────────────────────────
API_PORT=4000
WEB_PORT=5173
# 브라우저가 보는 앱 주소. 초대 링크·뷰어 링크가 이 주소로 만들어진다.
APP_ORIGIN=http://localhost:5173
# 세션 쿠키 서명 키. 32자 이상. `openssl rand -hex 32`
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ── Postgres ────────────────────────────────────────────────
POSTGRES_USER=tripmate
POSTGRES_PASSWORD=tripmate
POSTGRES_DB=tripmate
POSTGRES_PORT=5433
DATABASE_URL=postgresql://tripmate:tripmate@localhost:5433/tripmate

# ── 인증 ────────────────────────────────────────────────────
# mock  = 카카오 앱 없이 이름만 입력해 로그인 (개발 전용, production 에서 부팅 거부)
# kakao = 실제 카카오 OAuth
AUTH_MODE=mock
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:4000/api/auth/kakao/callback

# ── 저장소 ──────────────────────────────────────────────────
# local  = 서버 디스크(.data/storage). 개발·테스트 기본값
# gdrive = 운영자 Google Drive
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage

# Drive 연동 — 개발 완료 후 사용자가 채운다.
# OAuth 클라이언트 시크릿 + 리프레시 토큰이다. 서비스 계정 키도, API 키도 아니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# 모든 모임 폴더가 이 폴더 아래에 생긴다. 비우면 내 드라이브 루트.
# Drive 화면에서 손으로 만든 폴더를 넣어도 된다 — drive.file 은 그 폴더를 읽지는 못하지만
# 그 안에 만드는 것은 된다. 주소창의 /folders/<이 부분> 을 딴다.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ── 업로드 제한 ─────────────────────────────────────────────
MAX_UPLOAD_MB=200

# ── 프론트(빌드 타임) ───────────────────────────────────────
VITE_API_BASE=http://localhost:4000
