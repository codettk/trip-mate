{
  "name": "@tripmate/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "predev": "npm run build -w @tripmate/core",
    "dev": "node --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node src/db/migrate.ts up",
    "reset": "node src/db/migrate.ts reset",
    "seed": "node src/db/seed.ts",
    "pretest": "npm run build -w @tripmate/core",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^10.1.3",
    "@tripmate/core": "*",
    "exifr": "^7.1.3",
    "fastify": "^5.2.1",
    "googleapis": "^144.0.0",
    "kysely": "^0.27.5",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/pg": "^8.11.11",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
